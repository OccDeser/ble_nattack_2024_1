theory KEY_BF_TEST
begin

heuristic: S

builtins: diffie-hellman, symmetric-encryption, multiset
functions: extract/3, KDF/2, and/2,
  LOW/0, MIDIUNM/0, HIGH/0, CHAOTIC/0,
  entropy_increase/2, entropy_decrease/2
// A, B: sharing _ltk
// A -> B: max_key_size
// B -> A: max_key_size
// A, BL: key_size = min(A.max_key_size, B.max_key_size), LTK = _ltk[0:key_size]
// A -> B: SKD_A
// B -> A: SKD_B
// A, B: SKD = SKD_A || SKD_B, LTK = KDF(SKD, LTK)

// extract('0', a + b, k) = extract('0', a, k) | extract(a, a + b, k)  =  extract('0', b, k) | extract(b, a + b, k)
// extract('0', a, k) = fst(k)
// extract(a, a+b, k) = snd(k)
// extract('0', a + b, k) = <fst(k), snd(k)>

// low:         less than the highest entropy of the key which attacker can guess directly, low < 1 midium
// midium:      the highest entropy of the key which attacker can guess directly
// high:        the entropy of the key which attacker may have chances to guess, 1 midium < high <= n * midium
// chaotic:  the entropy of the key which attacker can never be able to guess, chaotic > n * midium

equations: 
  // low + low = midium
  entropy_increase(LOW, LOW) = MIDIUNM,
  // low + midium = midium
  entropy_increase(LOW, MIDIUNM) = MIDIUNM,
  entropy_increase(MIDIUNM, LOW) = MIDIUNM,
  // low + high = high
  entropy_increase(LOW, HIGH) = HIGH,
  entropy_increase(HIGH, LOW) = HIGH,
  // midium + midium = high
  entropy_increase(MIDIUNM, MIDIUNM) = HIGH,
  // midium + high = high
  entropy_increase(MIDIUNM, HIGH) = HIGH,
  // high + high = high
  entropy_increase(HIGH, MIDIUNM) = HIGH,
  entropy_increase(HIGH, HIGH) = HIGH,
  // chaotic + % = chaotic
  entropy_increase(x, CHAOTIC) = CHAOTIC,
  entropy_increase(CHAOTIC, x) = CHAOTIC,

  // low * % = low
  entropy_decrease(x, LOW) = LOW,
  entropy_decrease(LOW, x) = LOW,
  // midium * midium = midium
  entropy_decrease(MIDIUNM, MIDIUNM) = MIDIUNM,
  // midium * high = midium
  entropy_decrease(MIDIUNM, HIGH) = MIDIUNM,
  entropy_decrease(HIGH, MIDIUNM) = MIDIUNM,
  // midium * chaotic = midium
  entropy_decrease(MIDIUNM, CHAOTIC) = MIDIUNM,
  entropy_decrease(CHAOTIC, MIDIUNM) = MIDIUNM,
  // high * high = high
  entropy_decrease(HIGH, HIGH) = HIGH,
  // high * chaotic = high
  entropy_decrease(HIGH, CHAOTIC) = HIGH,
  entropy_decrease(CHAOTIC, HIGH) = HIGH,
  // chaotic * chaotic = chaotic
  entropy_decrease(CHAOTIC, CHAOTIC) = CHAOTIC


// rule entropy_leak_key:
//     [!Leak(key)]
//     --[Reveal(key)]->
//     [!Entropy(key, LOW)]

// rule inst_entropy_low:
//     [Entropy(key, LOW)]
//     -->
//     [!Entropy(key, LOW)]

// rule inst_entropy_chaotic:
//     [Entropy(key, CHAOTIC)]
//     -->
//     [!Entropy(key, CHAOTIC)]

rule entropy_break_low:
    [Entropy(key, LOW), In(senc(m, key))]
    --[Reveal(key)]->
    [!Leak(key)]

rule entropy_break_midium:
    [Entropy(key, MIDIUNM), In(senc(m, key))]
    --[Reveal(key)]->
    [!Leak(key)]

rule entropy_break_high1:
    [Entropy(<a, b>, HIGH), !Leak(a), Entropy(b, entropy)]
    --[_restrict(not(entropy=HIGH))]->
    [
      Entropy(<a, b>, entropy),
      Entropy(b, entropy)
    ]

rule entropy_break_high2:
    [Entropy(<a, b>, HIGH), !Leak(b), Entropy(a, entropy)]
    --[_restrict(not(entropy=HIGH))]->
    [
      Entropy(<a, b>, entropy),
      Entropy(a, entropy)
    ]


rule create_initiator:
    [] 
    --[
        Test0_1(),
        OnlyOnceV('CreateInitiator'),
        OnlyOnceV($I),
    ]->
    [ 
        !Device($I, <'highIKeySize', HIGH>, 'initiator')
    ]


rule create_responder:
    [] 
    --[
        Test0_2(),
        OnlyOnceV('CreateResponder'),
        OnlyOnceV($R),
    ]->
    [ 
        !Device($R, <'highRKeySize', HIGH>, 'responder')
    ]

rule share:
  let 
    ltkO = <~ltk_o, HIGH>
  in [!Device($I, mks_I, 'initiator'), !Device($R, mks_R, 'responder'), Fr(~ltk_o)]
  --[
    Test1(),
    Paired($I, $R, ~ltk_o),
    OnlyOnceV(<'Pair', $I, $R>),
  ]->
  [
    !SharedKey($I, $R, ltkO)
  ]

rule I_send_max_key_size:
  [!SharedKey($I, $R, ltkO), !Device($A, mks_A, 'initiator')]
  --[
    Test2(),
    OnlyOnceV(<'ISendMKS', $I, $R>),
  ]->
    [Out(<'I_MKS', mks_A>), ISentMKS($I, $R)]

rule R_send_max_key_size:
  let 
    ks_A = fst(mks_A)
    ks_A_e = snd(mks_A)
    ks_B = fst(mks_B)
    ks_B_e = snd(mks_B)
    ltk = and(and(ks_A, ks_B), fst(ltkO))
    entropy = entropy_decrease(entropy_decrease(ks_A_e, ks_B_e), snd(ltkO))
  in [
    !SharedKey($A, $B, ltkO), !Device($B, mks_B, 'responder'), In(<'I_MKS', mks_A>)
  ]
  --[
    Test3(),
    LtkCaculated($B, 'responder', ltk), 
    OnlyOnceV(<'RSendMKS', $A, $B>),
  ]->
  [
    Out(<'R_MKS', mks_B>),
    !LTK($B, <ltk, entropy>)
  ]

rule I_receive_max_key_size:
  let 
    ks_A = fst(mks_A)
    ks_A_e = snd(mks_A)
    ks_B = fst(mks_B)
    ks_B_e = snd(mks_B)
    ltk = and(and(ks_A, ks_B), fst(ltkO))
    entropy = entropy_decrease(entropy_decrease(ks_A_e, ks_B_e), snd(ltkO))
  in [
    !SharedKey($A, $B, ltkO), !Device($A, mks_A, 'initiator'), In(<'R_MKS', mks_B>), ISentMKS($A, $B)
  ]
  --[
    Test4(),
    LtkCaculated($A, 'initiator', ltk), 
    OnlyOnceV(<'IRecvMKS', $A, $B>),
  ]->[
    !LTK($A, <ltk, entropy>)
  ]

rule I_send_skd:
    [Fr(~skda), !LTK($A, ltk), !Device($A, mks_A, 'initiator')]
  --[
    Test6(),
    OnlyOnceV(<'ISendSKD', $A>),
  ]->
    [Out(<'I_SKD', ~skda>), SKD($A, ~skda)]

rule R_send_skd:
  let 
    skd = <~skda,~skdb>
    session_key = KDF(skd, fst(ltk))
    entropy = entropy_increase(LOW, snd(ltk))
  in [
    Fr(~skdb), In(<'I_SKD', ~skda>), 
    !LTK($B, ltk), !Device($B, mks_B, 'responder')
  ]
  --[
    // SessionEstablished($B, 'responder', session_key), 
    Test7(),
    OnlyOnceV(<'RSendSKD', $B>),
  ]-> 
  [
    Out(<'R_SKD', ~skdb>), 
    !Session($B, $A, <session_key, entropy>),
  ]

rule I_recv_skd:
  let 
    skd = <~skda,~skdb>
    session_key = KDF(skd, fst(ltk))
    confirm = senc('ISessionConfirm', session_key)
    entropy = entropy_increase(LOW, snd(ltk))
    in [
    In(<'R_SKD', ~skdb>), 
    SKD($A, ~skda), !LTK($A, ltk), !Device($A, mks_A, 'initiator')
  ]
  --[
    // SessionEstablished($A,'initiator',  session_key), 
    Test8(),
    OnlyOnceV(<'IRecvSKD', $A>),
  ]->
  [
    Out(<'I_SCFM', confirm>),
    !Session($A, $B, <session_key, entropy>),
    ISentSCFM($A)
  ]

rule R_recv_scfm:
  let 
    A_scfm = sdec(scfm, fst(session_key))
    confirm = senc('RSessionConfirm', fst(session_key))
  in [
    In(<'I_SCFM', scfm>),
    !Session($B, $A, session_key),
  ]
  --[
    _restrict(A_scfm='ISessionConfirm'),
    OnlyOnceV(<'RRecvScfm', $B>),
    SessionEstablished($B, 'responder', fst(session_key)), 
  ]->
  [
    Out(<'R_SCFM', confirm>),
  ]

rule I_recv_scfm:
  let 
    B_scfm = sdec(scfm, fst(session_key))
  in [
    In(<'R_SCFM', scfm>),
    !Session($A, $B, session_key),
  ]
  --[
    _restrict(B_scfm='RSessionConfirm'),
    OnlyOnceV(<'IRecvScfm', $A>),
    SessionEstablished($A, 'initiator', fst(session_key)), 
  ]->[
    Entropy(fst(session_key), snd(session_key))
  ] 


lemma Test0_1:
  exists-trace
  "
    Ex #i. Test0_1() @i
  "

lemma Test0_2:
  exists-trace
  "
    Ex #i. Test0_2() @i
  "
  
lemma Test1:
  exists-trace
  "
    Ex #i. Test1() @i
  "

lemma Test2:
  exists-trace
  "
    Ex #i. Test2() @i
  "
  
  lemma Test3:
  exists-trace
  "
    Ex #i. Test3() @i
  "

  lemma Test4:
  exists-trace
  "
    Ex #i. Test4() @i
  "

  lemma Test6:
  exists-trace
  "
    Ex #i. Test6() @i
  "
  lemma Test7:
  exists-trace
  "
    Ex #i. Test7() @i
  "
  lemma Test6_7:
  exists-trace
  "
    Ex #i #j. Test6() @i & Test7() @j
  "
  lemma Test2_6_7:
  exists-trace
  "
    Ex #i #j #k. Test6() @i & Test7() @j & Test3() @k
  "

  lemma Test8:
  exists-trace
  "
    Ex #i. Test8() @i
  "

  lemma TestPair:
  exists-trace
  "
    Ex userA userB ltk #i. Paired(userA, userB, ltk) @i
  "

  lemma TestCalcLTK:
  exists-trace
  "
    Ex userA userB ltkA ltkB ltk #i #j #k.
      LtkCaculated(userA, 'initiator', ltkA) @i & LtkCaculated(userB, 'responder', ltkB) @j & Paired(userA, userB, ltk) @k & ltkA = ltkB
  "

  lemma TestSession:
  exists-trace
  "
    Ex userA userB session_keyA session_keyB ltk #i #j #k.
      SessionEstablished(userA, 'initiator',session_keyA) @i & SessionEstablished(userB, 'responder', session_keyB) @j & Paired(userA, userB, ltk) @k & session_keyA = session_keyB
  "

lemma ltk_consistency:
"
  All userA userB ltkA ltkB ltk #i #j #k.
    LtkCaculated(userA, 'initiator', ltkA) @i & LtkCaculated(userB, 'responder', ltkB) @j & Paired(userA, userB, ltk) @k
  ==>
    ltkA = ltkB
"

lemma session_key_consistency:
"
  All userA userB session_keyA session_keyB ltk #i #j #k.
    SessionEstablished(userA, 'initiator', session_keyA) @i & SessionEstablished(userB, 'responder', session_keyB) @j & Paired(userA, userB, ltk) @k
  ==>
    session_keyA = session_keyB
"

lemma sk_leak:
exists-trace
"
  Ex user role session_key #i #j. SessionEstablished(user, role, session_key)@i & Reveal(session_key)@j
"

restriction OnlyOnceV:
"All #i #j x. OnlyOnceV(x)@#i & OnlyOnceV(x)@#j ==> #i = #j"

restriction PairOnceAtATime:
"All #i #j a b ltk1 ltk2. Paired(a, b, ltk1)@#i & Paired(a, b, ltk2)@#j & not (ltk1 = ltk2) ==> not (#i = #j)"

end
